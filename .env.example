# --- Hardhat / deployment ---
PRIVATE_KEY=                    # deployer wallet private key (testnet only for hackathon)
HSK_TESTNET_RPC_URL=            # see https://hskchain.net docs
HSK_TESTNET_CHAIN_ID=
HSK_MAINNET_RPC_URL=
HSK_MAINNET_CHAIN_ID=
STABLECOIN_ADDRESS=             # ERC-20 stablecoin address on the target network

# --- Backend (backend/main.py) ---
# AI matching: leave AI_SERVICE_URL unset to use Hugging Face's Inference API
# (works in production, no model server to deploy). Set AI_SERVICE_URL to
# override with a local ai_matching_service.py (open_clip) during development.
AI_SERVICE_URL=
HF_API_TOKEN=                  # https://huggingface.co/settings/tokens - needs "Make calls to Inference Providers"
HF_CLIP_MODEL=openai/clip-vit-base-patch32
HSK_RPC_URL=https://rpc-testnet.hskchain.net
AUTOCHAIN_CONTRACT_ADDRESS=     # deployed AutoChainReward address
VALIDATOR_PRIVATE_KEY=          # wallet whitelisted via asignarValidador()

# --- Supabase (persistence: vehicles/cases/tips tables + photo/document storage) ---
# Create a free project at https://supabase.com, run backend/supabase_schema.sql
# in its SQL Editor, then copy these from Project Settings -> API.
SUPABASE_URL=                   # e.g. https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=            # "secret" key (service-role equivalent) - backend only, never expose to the frontend
